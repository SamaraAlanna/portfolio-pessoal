# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# skills de agente
# O .agents e o skills-lock.json entram no repositório: são a skill e a origem dela.
# O .claude é onde o instalador expõe a skill para esta máquina, e é artefato local.
.claude/

# debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tool caches
.eslintcache

# env files (can opt-in for committing if needed)
.env*
!.env.example

# imagens de origem
# Os PNGs de origem sao grandes e entram no historico do Git para sempre se escaparem. O que
# vai para o repositorio e o WebP tratado em public/imagens, e nao o original.
/imagens-originais/

# certificados originais
# OS PDFs DE CERTIFICADO PODEM TRAZER CPF, RG, DATA DE NASCIMENTO E ENDERECO, E ESTE
# REPOSITORIO E PUBLICO. Nada desta pasta vai para o GitHub. Os arquivos daqui tambem nunca
# sao copiados para public/ nem para qualquer outro lugar versionado sem aprovacao da Samara:
# o que for publicado sai de imagem tratada, e nao do original.
/certificados-originais/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
